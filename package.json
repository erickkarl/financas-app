{
  "name": "financas-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "pluggy-js": "^0.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.5",
    "react-native-pluggy-connect": "^1.6.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/src/**/*.test.ts?(x)"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "\\.node\\.test\\.ts$"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-router|react-native-paper|react-native-pluggy-connect|@callstack/.*))"
        ]
      },
      {
        "displayName": "dados",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/**/*.node.test.ts"
        ],
        "transform": {
          "^.+\\.tsx?$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        }
      }
    ]
  },
  "private": true
}
